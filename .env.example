# Beget account credentials for acme.sh's official dns_beget plugin
# (bundled in the image - github.com/acmesh-official/acme.sh/wiki/dnsapi2#dns_beget),
# used for the Let's Encrypt DNS-01 challenge. Required for wildcard
# certs: HTTP-01 can't issue them. Enable API access first: Beget control
# panel -> "Настройки аккаунта" -> "Доступ по api" -> включить "Разрешить
# доступ по IP" / "Технология Beget API".
Beget_Username=
Beget_Password=
